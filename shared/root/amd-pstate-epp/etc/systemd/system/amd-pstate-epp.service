[Unit]
Description=Define EPP (balance_power) no amd-pstate-epp após boot
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo balance_power > "$f" 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target
