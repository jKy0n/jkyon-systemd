#!/bin/sh
# Assina com o sbctl (Secure Boot, chaves próprias) o kernel que o installkernel
# copia pra /boot/kernel-<versão> no 90-compat.install (layout "compat"/"grub",
# carregado pelo GRUB). Comum às máquinas com SB: TheseusMachine, Viamar-PC e
# Builder. O GRUB assinado é de cada máquina (grub-sb-build da TheseusMachine,
# sem shim, e do Viamar-PC, atrás do shim; o Builder usa o GRUB normal).
#
# Por que não o 91-sbctl.install do pacote: ele assume o layout BLS e assina
# $ENTRY_DIR_ABS/linux, que não existe no layout grub (falharia a instalação do
# kernel). Ele está mascarado aqui ao lado: 91-sbctl.install vazio (o
# kernel-install trata arquivo vazio ou link pra /dev/null como máscara; o stow
# não aceita link absoluto).
#
# "sign -s" guarda o arquivo no banco do sbctl (sbctl list-files / sign-all).

COMMAND="$1"
KERNEL_VERSION="$2"
IMAGE="/boot/kernel-$KERNEL_VERSION"

case "$COMMAND" in
add)
	if ! [ "$(sbctl setup --print-state --json | awk '/installed/ { gsub(/,$/,"",$2); print $2 }')" = "true" ]; then
		echo "sbctl-kernel: sem chaves do sbctl, kernel não assinado"
		exit 0
	fi
	if ! [ -f "$IMAGE" ]; then
		echo "sbctl-kernel: $IMAGE não existe" >&2
		exit 1
	fi
	sbctl sign -s "$IMAGE" >/dev/null || exit 1
	echo "sbctl-kernel: kernel assinado ($IMAGE)"
	;;
remove)
	sbctl remove-file "$IMAGE" >/dev/null 2>&1 || :
	;;
esac
