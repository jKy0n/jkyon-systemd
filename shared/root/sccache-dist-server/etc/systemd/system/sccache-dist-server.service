[Unit]
Description=jKyon sccache-dist build server (Rust — compilação distribuída)
After=network-online.target tailscaled.service
Wants=network-online.target
OnFailure=notify-failure@%N.service

[Service]
Type=simple
# Config real fica em /etc/sccache-dist/server.conf — NÃO versionado aqui de
# propósito (contém scheduler_auth.token, secreto por máquina). Ver runbook
# em jkyon-ai-context/machines/sccache-dist.md pra gerar/instalar o arquivo.
ExecStart=/usr/bin/sccache-dist server --config /etc/sccache-dist/server.conf
CacheDirectory=sccache-dist
Restart=on-failure
RestartSec=5s
# Requer root de verdade (overlay builder monta/desmonta via bubblewrap) —
# não rodar como usuário, mesmo que sccache-dist não recuse explicitamente.
User=root

[Install]
WantedBy=multi-user.target
